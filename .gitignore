*.rbxl
*.rbxl.lock
*.rbxlx
*.rbxm
*.rbxmx

# ...except hand-authored model templates under assets/, which ARE source.
# Prefer .model.json there (line-diffable); .rbxmx is XML and diffs poorly,
# so only reach for it when a template uses instances .model.json can't express.
!/assets/**/*.rbxm
!/assets/**/*.rbxmx

# Bundled tool binaries — pinned in aftman.toml, fetch via `aftman install`
/tools/*.exe

# Rojo
/sourcemap.json

# Wally
/Packages/
/ServerPackages/
/DevPackages/
wally.lock

# Aftman/tool caches
.aftman/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.claude
.agents
AGENTS.md
# reload.ps1 incremental cache
/.reload/
